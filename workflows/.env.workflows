# HoneyGo Workflow Environment Variables
# Copy to .env in n8n settings or export before running

# ============================================
# Weather API - OpenWeatherMap
# ============================================
# Sign up: https://openweathermap.org/api
# FREE tier: 1,000 calls/day
WEATHER_API_KEY=your_openweathermap_key_here

# ============================================
# Events API - Ticketmaster
# ============================================
# Sign up: https://developer.ticketmaster.com/
# FREE tier available
EVENTS_API_KEY=your_ticketmaster_key_here

# ============================================
# Traffic API - Google Maps (Optional)
# ============================================
# Requires billing, use mock data instead
# TRAFFIC_API_KEY=your_google_maps_key_here

# ============================================
# n8n Webhook URLs (after activation)
# ============================================
# These URLs are generated when you activate workflows
# Update backend .env with these values
N8N_WEATHER_WEBHOOK=http://localhost:5678/webhook/weather-data
N8N_EVENTS_WEBHOOK=http://localhost:5678/webhook/event-data
N8N_TRAFFIC_WEBHOOK=http://localhost:5678/webhook/traffic-data

# ============================================
# Backend Integration
# ============================================
HONEYGO_BACKEND_URL=http://localhost:8000
