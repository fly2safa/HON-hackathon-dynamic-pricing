# ============================================
# HoneyGo Environment Variables Template
# ============================================
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env in the ROOT folder of the project
#    Command: cp env.example .env (Mac/Linux) or copy env.example .env (Windows)
# 2. Update .env with your real API keys and values
# 3. Keep .env in the root folder (same level as this file)
# 4. NEVER commit .env to Git (already in .gitignore)

# ============================================
# LangSmith (Agent Observability) - HIGHLY RECOMMENDED
# ============================================
# Used by: LangChain Agent (Role 4)
# Purpose: Real-time tracing and debugging of AI agent decisions
# Cost: FREE (5,000 traces/month)
# Demo Value: Show judges HOW the agent thinks in real-time!
# 
# Setup:
# 1. Sign up at: https://smith.langchain.com (use GitHub login)
# 2. Create project: "honeygo-pricing"
# 3. Get API key from Settings → API Keys
# 4. Paste key below
#
# Role 4 (Safa) creates account and shares key with team
# Note: LANGSMITH_API_KEY is primary; LANGCHAIN_API_KEY also works (fallback)
LANGSMITH_API_KEY=lsv2_pt_your_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=honeygo-pricing

# ============================================
# LLM Provider (REQUIRED - Choose One)
# ============================================
# Used by: LangChain Agent (Role 4)
# Purpose: Powers the AI reasoning for dynamic pricing decisions

# OPTION 1: OpenAI (GPT-4) - Recommended for best reasoning
# Get API key from: https://platform.openai.com/api-keys
# Cost: ~$0.01-0.03 per pricing calculation
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your_openai_key_here
AGENT_MODEL=gpt-4-turbo-preview

# OPTION 2: Google AI (Gemini) - FREE or very cheap with school account
# Get API key from: https://makersuite.google.com/app/apikey
# Cost: FREE or minimal
# LLM_PROVIDER=google
# GOOGLE_API_KEY=your_google_ai_key_here
# AGENT_MODEL=gemini-pro

# OPTION 3: Anthropic Claude (Alternative)
# Get API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
# AGENT_MODEL=claude-3-sonnet-20240229

# Agent Configuration
AGENT_TEMPERATURE=0.7
AGENT_MAX_ITERATIONS=10

# ============================================
# MongoDB (Database) - REQUIRED
# ============================================
# Used by: Backend (Role 3), Agent (Role 4)
# Purpose: Store rides, pricing decisions, customers, drivers
# Cost: FREE (Atlas M0 tier or local)
#
# OPTION 1: MongoDB Atlas (Cloud - Recommended)
# Role 2 (Jason) creates FREE M0 cluster and shares connection string
# Get from: https://cloud.mongodb.com
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGODB_URI=mongodb+srv://username:password@cluster0.qpxvnax.mongodb.net/HoneyGo?retryWrites=true&w=majority

# OPTION 2: Local MongoDB (Development)
# Install: https://www.mongodb.com/try/download/community
# Run: mongod
# MONGODB_URI=mongodb://localhost:27017/honeygo_pricing

# ============================================
# ChromaDB (Vector Database) - OPTIONAL for Phase 1
# ============================================
# Used by: Agent (Role 4), Backend (Role 3)
# Purpose: Semantic search for similar pricing contexts (RAG)
# Cost: FREE (self-hosted)
# 
# Role 5 (Safa) sets up locally - no API key needed
# Install: pip install chromadb
# Runs automatically on localhost:8000
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_PERSIST_DIRECTORY=./data/chromadb

# ============================================
# Backend API Configuration
# ============================================
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================
# External APIs (OPTIONAL - For Enhanced Demo)
# ============================================
# Used by: n8n/MCP workflows (Role 6), Agent tools
# Purpose: Real-time data enrichment
# Note: Agent has mock data, these enhance realism

# Weather API (OpenWeatherMap - FREE tier: 1000 calls/day)
# Get from: https://openweathermap.org/api
# Purpose: Real weather conditions affecting pricing
# WEATHER_API_KEY=your_weather_api_key_here

# Events API (Ticketmaster - FREE tier)
# Get from: https://developer.ticketmaster.com/
# Purpose: Detect events causing surge pricing
# EVENTS_API_KEY=your_events_api_key_here

# Traffic API (Google Maps - requires billing, OPTIONAL)
# Get from: https://console.cloud.google.com/
# Purpose: Real-time traffic for duration estimates
# TRAFFIC_API_KEY=your_traffic_api_key_here

# ============================================
# n8n/MCP Configuration (OPTIONAL)
# ============================================
# Used by: Workflow Integration (Role 6 - Steve)
# Purpose: Orchestrate external data fetching
# Cost: FREE (self-hosted n8n)
# 
# Role 6 (Steve) will choose between n8n or MCP
# If using n8n:
N8N_HOST=localhost
N8N_PORT=5678
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/pricing-data

# ============================================
# Development Settings
# ============================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info

# ============================================
# Setup Instructions
# ============================================
# 1. Copy this file: cp env.example .env
# 2. Update values above with real API keys
# 3. Share keys securely with team (Slack DM)
# 4. NEVER commit .env to Git

# ============================================
# Cost Estimate (for hackathon)
# ============================================
# LangSmith: FREE (5,000 traces/month)
# OpenAI: ~$5-20 (GPT-3.5 or GPT-4)
# MongoDB Atlas: FREE (M0 tier, 512 MB)
# ChromaDB: FREE (self-hosted)
# n8n: FREE (self-hosted)
# Total: ~$5-20 (mostly LLM API calls)

