# Frontend Dockerfile for Next.js
# Role 11: Docker/DevOps Engineer
# TODO: Finalize this during Dec 2-3 implementation

FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY frontend/package*.json ./
RUN npm ci

# Copy application code
COPY frontend/ .

# Build the application
RUN npm run build

# Expose port
EXPOSE 3000

# Run the application
CMD ["npm", "start"]

