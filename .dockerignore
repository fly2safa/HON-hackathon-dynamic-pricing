# Docker ignore rules for HoneyGo
# Role 11: Docker/DevOps Engineer

# Dependencies
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
pip-log.txt
pip-delete-this-directory.txt

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*.swn
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Git
.git/
.gitignore
.gitattributes

# Documentation
docs/
project-spec/
*.md
README.md

# Build outputs
.next/
dist/
build/
out/
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Temporary files
*.tmp
*.temp
.cache/

# Docker files (don't copy into containers)
Dockerfile*
docker-compose*.yml
.dockerignore

# Data files (should be mounted as volumes)
data/raw/*
data/mongodb/*
data/chromadb/*
data/mock/*

# Workspace files
*.code-workspace

